# Public source allowlist. Other workspace data stays local by default.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/docs/
!/tools/
!/examples/
!/C1ancher/
!/App/
!/Pinao/
!/ChiChuGames/
!/term-ime/

# Build products, device evidence, caches and local environments.
**/build/
**/build-*/
**/artifacts/
**/dist/
**/bin/
**/obj/
**/.venv/
**/venv/
**/__pycache__/
**/.pytest_cache/
**/node_modules/
**/.cursor/
**/.vscode/
**/.idea/
*.pyc
*.pyo
*.o
*.a
*.exe
*.dll
*.pdb
*.log
*.state
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.bak
*.backup
*.wav

# Credentials and private operational material. Public keys remain publishable.
.env
.env.*
!.env.example
*.token
*.key
*.pem
*.p12
*.pfx
id_rsa*
id_ed25519
**/secrets/
**/private/
**/credentials/

# Core source roots only; retain existing source and licensed third parties.
/C1ancher/*
!/C1ancher/.gitignore
!/C1ancher/.gitattributes
!/C1ancher/LICENSE
!/C1ancher/Makefile
!/C1ancher/README.md
!/C1ancher/THIRD_PARTY_NOTICES.md
!/C1ancher/VERSION
!/C1ancher/config/
!/C1ancher/docs/
!/C1ancher/installer/
!/C1ancher/scripts/
!/C1ancher/src/
!/C1ancher/tests/
!/C1ancher/third_party/
!/C1ancher/tools/

# These projects stay local and are excluded from all future uploads.
/C1ancher-server/
/tools/publisher/
/InkWars/

# Maintainer-only deployment helpers are not an application developer interface.
/Pinao/scripts/authorize-server.py
/Pinao/publish.ps1
/Pinao/docs/validation.md
/ChiChuGames/catalog.json
/ChiChuGames/tools/launch.sh
/ChiChuGames/tools/make-repo.sh
